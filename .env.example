# --- Nebius Token Factory (required for real runs) -------------------------
NEBIUS_API_KEY=
# Nebius's quickstart gives this global endpoint; its cookbook examples use
# https://api.tokenfactory.us-central1.nebius.com/v1/ instead. `reprofix doctor` tries both with your key.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Model IDs per routing tier. Nebius's pages spell the Nano ID two ways (cookbook: nvidia/nvidia-nemotron-3-nano-30b-a3b,
# catalog: nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B); ReproFix matches IDs against GET /models ignoring case, and
# `reprofix doctor` tells you what your key is served.
NEBIUS_MODEL_NANO=nvidia/nvidia-nemotron-3-nano-30b-a3b
NEBIUS_MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
NEBIUS_MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b

# USD per 1M tokens, "input,output". Defaults are the prices in Nebius's model catalog; prices change, so check them.
# Set a tier empty (e.g. REPROFIX_PRICE_NANO=) to report its cost as n/a.
# REPROFIX_PRICE_NANO=0.06,0.24
# REPROFIX_PRICE_SUPER=0.30,0.90
# REPROFIX_PRICE_ULTRA=1.00,3.00

# Optional JSON merged into every chat request body (e.g. reasoning toggles, once you've
# confirmed the parameter name for your model on Token Factory).
# NEBIUS_EXTRA_BODY={}

# --- Tavily (optional; enables external evidence) ---------------------------
TAVILY_API_KEY=

# --- Known issues ------------------------------------------------------------
# 1 (default): when a run is not already passing, search the GitHub issues of the repository (unauthenticated, no token) and,
# with a Tavily key, a few code-help sites for the failure it observed. A short query made of identifiers from the failure
# (no paths, no operators) leaves this machine. Results are shown as "possibly related, not verified" and given to the
# models as untrusted text. Set 0 to send nothing.
REPROFIX_KNOWN_ISSUES=1

# --- Sandbox -----------------------------------------------------------------
# docker (default, isolated) | local (DEV ONLY: no filesystem isolation)
REPROFIX_SANDBOX=docker
REPROFIX_SANDBOX_IMAGE=reprofix-sandbox:latest
# Set to 1 to permit the local backend at all.
REPROFIX_ALLOW_UNSAFE_LOCAL=0
# 1 = pass --gpus all to docker for the run phase.
REPROFIX_SANDBOX_GPU=0
# 1 = allow source distributions (setup.py executes at install time with network on).
REPROFIX_ALLOW_SDIST=0
# Network of the Docker INSTALL phase. open: the default bridge, any host reachable. proxy: an --internal Docker network
# plus an allow-list proxy that only tunnels HTTPS to REPROFIX_EGRESS_ALLOW. Start it with `reprofix egress up`
# (docker compose and the systemd unit do it for you); installs are refused if it is not ready.
# Left unset on purpose: the default is `open` for a plain `reprofix serve`, but `proxy` for docker-compose.yml and the
# systemd unit. Setting it here would override those (Compose reads this file for variable substitution too).
# REPROFIX_INSTALL_NETWORK=proxy
# Hosts the proxy may tunnel to. Add e.g. download.pytorch.org for CPU-only torch wheels (untested).
# REPROFIX_EGRESS_ALLOW=pypi.org,files.pythonhosted.org
# Optional: reach the Internet through another HTTP proxy.
# REPROFIX_EGRESS_UPSTREAM=

# --- Server ------------------------------------------------------------------
REPROFIX_DATA_DIR=./data
REPROFIX_API_TOKEN=
REPROFIX_MAX_CONCURRENT_RUNS=2
REPROFIX_ALLOWED_GIT_HOSTS=github.com
# Set to 1 only on a trusted dev machine to allow `local_path` repos from the API.
REPROFIX_ALLOW_LOCAL_PATHS=0

# --- Pull requests (the "Open pull request" button and `reprofix pr`) -----------
# 1 (default) lets the server open a pull request on GitHub with a token that the person using the UI types in.
# The server never stores that token. Set 0 to remove the feature from the server and the UI (`reprofix pr` is a
# separate command that runs as you and is not affected).
REPROFIX_ALLOW_PULL_REQUESTS=1
# `reprofix pr` reads its token from this variable (never from the command line). Prefer exporting it in your shell.
# GITHUB_TOKEN=

# --- Deployment (docker-compose.yml; see docs/deployment.md) ------------------------
# Host docker group id:  getent group docker | cut -d: -f3
# DOCKER_GID=
# Host directory for runs and the database. It is mounted at the SAME path in the app container. Owned by uid 1000.
# REPROFIX_HOST_DATA_DIR=/srv/reprofix
# Only with `docker compose --profile tls up -d`: the DNS name Caddy gets a certificate for.
# REPROFIX_DOMAIN=
